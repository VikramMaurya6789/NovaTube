<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTube round2: middle segment of the like/dislike/comment/save pill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nt_pill_fill_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nt_pill_fill" />
        </shape>
    </item>
</selector>
