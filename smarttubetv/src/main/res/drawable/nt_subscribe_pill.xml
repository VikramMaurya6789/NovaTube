<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTube round2: high-contrast white Subscribe pill (official YT TV style) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nt_subscribe_bg" />
            <stroke android:width="3dp" android:color="@color/nt_pill_icon_focused" />
            <corners android:radius="@dimen/nt_pill_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nt_subscribe_bg" />
            <corners android:radius="@dimen/nt_pill_corner_radius" />
        </shape>
    </item>
</selector>
