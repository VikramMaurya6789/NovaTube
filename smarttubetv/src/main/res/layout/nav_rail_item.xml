<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTube round2: single nav rail item (inflated into NavRailItemView) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/rail_item_icon"
        android:layout_width="@dimen/nav_rail_icon_size"
        android:layout_height="@dimen/nav_rail_icon_size"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/rail_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:singleLine="true"
        android:textSize="14sp"
        android:visibility="gone" />

</merge>
